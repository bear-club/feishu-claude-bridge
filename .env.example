FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Claude 模型（默认 claude-opus-4-6）
CLAUDE_MODEL=claude-opus-4-6

# Claude 可用工具（逗号分隔，默认 Read,Glob,Grep,Edit,Write,Bash）
# 全量工具列表见: https://github.com/anthropics/claude-agent-sdk-typescript
# 常用: Read, Write, Edit, Glob, Grep, Bash, WebSearch, WebFetch, Agent, NotebookEdit
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,Bash

# 权限策略（唯一的权限控制项）
# bypass   — 全部放行，无审批（默认）
# cautious — 分级：只读放行，普通通知，危险需飞书审批
# strict   — 仅只读放行，其余全部拒绝
CLAUDE_PERMISSION_POLICY=cautious

# ── 以下仅在 cautious/strict 模式下生效 ──

# 额外自动放行工具（逗号分隔）
# 基础自动放行: Read, Glob, Grep（始终放行，无需配置）
# 此处配置额外不需要审批/通知的工具，如 Edit,Write,WebSearch,WebFetch
CLAUDE_SAFE_TOOLS=Edit, Write

# 危险命令模式（逗号分隔，匹配到的 Bash 命令需要飞书审批）
# 留空使用内置默认列表（含 git push/reset, rm, DROP TABLE 等 30+ 模式）
CLAUDE_DANGEROUS_PATTERNS=

# 审批超时（毫秒，超时自动拒绝，默认 60000 = 60秒）
CLAUDE_APPROVAL_TIMEOUT_MS=60000

# Claude 执行的默认工作目录
DEFAULT_CWD=D:\play\feishu-claude-bridge

# 允许的工作目录白名单（逗号分隔）
ALLOWED_DIRS=D:\play,D:\projects

# /new 指令中展示的快捷目录（逗号分隔，可选）
SHORTCUT_DIRS=D:\play\feishu-claude-bridge,D:\projects\my-app
